# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Public URL of the deployed site (used for metadata, sitemap, OG tags).
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ---------------------------------------------------------------------------
# Database — Neon Postgres (https://neon.tech)
# ---------------------------------------------------------------------------
# Create a free Neon project, copy the pooled connection string it gives you.
# Leave unset to run the site in demo mode (static seed projects, read-only admin).
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# ---------------------------------------------------------------------------
# Admin auth
# ---------------------------------------------------------------------------
# Long random string used to sign admin session cookies. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET=

# Email that can sign in at /admin/login
ADMIN_EMAIL=you@marginoferror.dev

# Bcrypt hash of the admin password. Generate with:
#   npm run admin:hash -- "your-password"
ADMIN_PASSWORD_HASH=

# ---------------------------------------------------------------------------
# Email — SMTP (contact form notifications)
# ---------------------------------------------------------------------------
# Works with any SMTP provider: Gmail (app password), Resend, Postmark,
# SendGrid, Amazon SES, or your own mail server.
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=you@marginoferror.dev
SMTP_PASSWORD=

# Where contact-form leads are delivered (defaults to SMTP_USER).
CONTACT_TO_EMAIL=hello@marginoferror.dev
# "From" address on outgoing notification emails (defaults to SMTP_USER).
CONTACT_FROM_EMAIL=hello@marginoferror.dev
